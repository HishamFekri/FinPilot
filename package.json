{
  "name": "finpilot",
  "version": "0.1.0",
  "private": true,
  "description": "Personal finance and shared expense management",
  "engines": {
    "node": ">=24"
  },
  "workspaces": [
    "apps/web"
  ],
  "scripts": {
    "dev": "npm run dev -w @finpilot/web",
    "build": "npm run build -w @finpilot/web",
    "lint": "npm run lint -w @finpilot/web",
    "typecheck": "npm run typecheck -w @finpilot/web",
    "test": "npm run test -w @finpilot/web",
    "format": "prettier --write \"apps/web/**/*.{ts,tsx,mjs,css,json}\" \"*.{json,md}\"",
    "format:check": "prettier --check \"apps/web/**/*.{ts,tsx,mjs,css,json}\" \"*.{json,md}\""
  },
  "devDependencies": {
    "prettier": "^3.9.10"
  }
}
