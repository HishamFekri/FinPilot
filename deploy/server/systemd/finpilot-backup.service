[Unit]
Description=FinPilot: encrypted database backup (restic) with retention
Documentation=file:///srv/docker/finpilot/deploy/server/README.md
Requires=docker.service srv-storage.mount
After=docker.service srv-storage.mount

[Service]
Type=oneshot
EnvironmentFile=/etc/finpilot/deployer.env
ExecStart=/srv/docker/finpilot/deploy/server/finpilot-backup.sh
TimeoutStartSec=2h
NoNewPrivileges=yes
PrivateTmp=yes
ProtectHome=yes
ProtectSystem=strict
ReadWritePaths=/srv/docker/finpilot/deploy/state /etc/finpilot/docker /var/cache/finpilot-restic /srv/storage/backups/finpilot /run
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectControlGroups=yes
RestrictSUIDSGID=yes
LockPersonality=yes
