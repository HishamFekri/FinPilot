[Unit]
Description=FinPilot: deploy the latest tested release, or check the running one
Documentation=file:///srv/docker/finpilot/deploy/server/README.md
Requires=docker.service srv-storage.mount
After=docker.service srv-storage.mount network-online.target
Wants=network-online.target

[Service]
Type=oneshot
EnvironmentFile=/etc/finpilot/deployer.env
ExecStart=/srv/docker/finpilot/deploy/server/finpilot-deployer.sh
TimeoutStartSec=45min
# Sandbox: it may write only its own state, its registry login, the restic cache and backups.
NoNewPrivileges=yes
PrivateTmp=yes
ProtectHome=yes
ProtectSystem=strict
ReadWritePaths=/srv/docker/finpilot/deploy/state /etc/finpilot/docker /var/cache/finpilot-restic /srv/storage/backups/finpilot /run
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectControlGroups=yes
RestrictSUIDSGID=yes
LockPersonality=yes
