# /etc/finpilot/deployer.env (root, 0600): read by finpilot-deploy.service and finpilot-backup.service.
# Paths only: every secret is a separate root-only file, never a value in this file.

FINPILOT_DIR=/srv/docker/finpilot
FINPILOT_PUBLIC_URL=https://finpilot.hishamjouda.com

# Pulling the private images: a GitHub token with read:packages ONLY (no repo, no write).
FINPILOT_GHCR_USER=HishamFekri
FINPILOT_GHCR_TOKEN_FILE=/etc/finpilot/ghcr-token

# Encrypted backups on the external disk. The password file is generated by install.sh.
FINPILOT_RESTIC_REPOSITORY=/srv/storage/backups/finpilot/restic
FINPILOT_RESTIC_PASSWORD_FILE=/etc/finpilot/restic-password

# Optional: Uptime Kuma push monitor URLs (one line each). Leave the files absent to skip.
FINPILOT_KUMA_DEPLOY_URL_FILE=/etc/finpilot/kuma-deploy-url
FINPILOT_KUMA_BACKUP_URL_FILE=/etc/finpilot/kuma-backup-url
