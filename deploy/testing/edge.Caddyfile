# Stack test only (compose.stacktest.yaml): a stand-in for Cloudflare plus the server's existing
# Caddy, configured the way the real one is to be (deploy/README.md, "Behind the existing proxy").
#
# - TLS with its own internal test CA, on 18443 (the test origin's port).
# - Trusts exactly one client, EDGE_TRUSTED_CLIENT (the test runner, in cloudflared's role), for
#   Cf-Connecting-Ip, which Cloudflare sets and visitors can't. From anyone else, the connecting
#   address is the client.
# - Forwards one address to the FinPilot proxy: header_up X-Forwarded-For {client_ip}. Host is
#   passed through unchanged.

{
	http_port 18080
	https_port 18443
	auto_https disable_redirects
	skip_install_trust
	admin 127.0.0.1:2019
	servers {
		trusted_proxies static {$EDGE_TRUSTED_CLIENT}/32
		trusted_proxies_strict
		client_ip_headers Cf-Connecting-Ip
	}
}

{$FINPILOT_HOST} {
	tls internal
	# Cloudflare replaces these in production, so the tests keep checking FinPilot's own headers.
	header {
		-Server
		-Via
	}
	reverse_proxy {$EDGE_UPSTREAM} {
		header_up X-Forwarded-For {client_ip}
	}
}
