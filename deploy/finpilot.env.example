# FinPilot site settings. Copy to deploy/finpilot.env on the server and fill in.
# Nothing in this file is secret: secrets are files in deploy/secrets/ (scripts/init-secrets.sh).
# Image digests aren't here either: each release has its own file (see release.env.example).

# "tunnel": the home server. Cloudflare Tunnel -> cloudflared -> 127.0.0.1:FINPILOT_TUNNEL_PORT;
#           the existing Caddy isn't involved (deploy/server/README.md).
# "behind": behind another reverse proxy, on the internal finpilot_edge network.
# "direct": this proxy terminates TLS and publishes the loopback ports below.
FINPILOT_PROXY_MODE=tunnel
FINPILOT_TUNNEL_PORT=18085
# Tunnel mode trusts Cf-Connecting-Ip only from this address: the egress network's gateway.
FINPILOT_EGRESS_GATEWAY=172.30.12.1

# Closed beta: "allowlist" (secrets/beta_allowlist) or "closed". "open" is refused in production.
FINPILOT_REGISTRATION_MODE=allowlist

# The site's own hostname: a dedicated subdomain, never an apex that serves other sites.
FINPILOT_HOST=finpilot.example.com
# The public HTTPS origin people type. Include the port only if it isn't 443.
FINPILOT_ORIGIN=https://finpilot.example.com

# Behind mode: the existing proxy's fixed address on finpilot_edge (the only one believed for
# X-Forwarded-For), and this proxy's own address there.
FINPILOT_EDGE_SUBNET=172.30.13.0/29
FINPILOT_EDGE_PROXY_IP=172.30.13.2
FINPILOT_EDGE_IP=172.30.13.3

# Direct mode only.
# "internal": Caddy's own CA (private stage over the LAN or Tailscale; browsers must trust it).
# An email address: a public Let's Encrypt certificate (needs ports 80 and 443 reachable).
FINPILOT_TLS=internal
# Where the proxy listens on the host. Loopback by default, so nothing is exposed by accident.
# 8080 is taken on the home server by the existing Caddy.
FINPILOT_BIND_ADDRESS=127.0.0.1
FINPILOT_HTTPS_PORT=8443
FINPILOT_HTTP_PORT=8085

# The production Google OAuth client's ID. Its secret goes in secrets/google_client_secret.
# Register exactly ${FINPILOT_ORIGIN}/api/v1/auth/google/callback as its redirect URI.
FINPILOT_GOOGLE_CLIENT_ID=REPLACE_ME.apps.googleusercontent.com

FINPILOT_DATABASE=finpilot

# Subnets unused on the host (docs/SERVER_READINESS.md §9), and the proxy's fixed address on
# front. The API believes X-Forwarded-For from that address only.
FINPILOT_FRONT_SUBNET=172.30.10.0/24
FINPILOT_PROXY_IP=172.30.10.2
FINPILOT_DATA_SUBNET=172.30.11.0/24
FINPILOT_EGRESS_SUBNET=172.30.12.0/24

# Third-party images, by digest at release time. Replace the tags with name:tag@sha256:...
FINPILOT_POSTGRES_IMAGE=postgres:18.1-trixie
FINPILOT_CADDY_IMAGE=caddy:2.10.2-alpine

# Where secrets live. Root-owned; see scripts/init-secrets.sh.
FINPILOT_SECRETS_PATH=./secrets
