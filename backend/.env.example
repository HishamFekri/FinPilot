# Copy to backend/.env, which Git ignores. These are placeholders, not real credentials.
# scripts/provision_local_db.py can create the databases and write this file for you.

# development | test | demo | production
APP_ENV=development
LOG_LEVEL=INFO

# A database created only for FinPilot. Never reuse another application's database or credentials.
DATABASE_URL=postgresql+psycopg://finpilot_dev_user:CHANGE_ME@127.0.0.1:5432/finpilot_dev

# Used only by tests. The database name must end in _test, and the host must be local.
# Leave it unset to skip database tests.
# TEST_DATABASE_URL=postgresql+psycopg://finpilot_test_user:CHANGE_ME@127.0.0.1:5432/finpilot_test

# Google sign-in, the only way to authenticate. Leave all three unset to keep it off.
# Never commit real values. Development and production use separate OAuth clients.
# The redirect URI must match one registered in Google Cloud exactly. Use localhost, not 127.0.0.1.
# GOOGLE_CLIENT_ID=your-client-id.apps.googleusercontent.com
# GOOGLE_CLIENT_SECRET=CHANGE_ME
# GOOGLE_REDIRECT_URI=http://localhost:8000/api/v1/auth/google/callback

# Production: APP_ENV=production, https origins, and its own database and Google client.
# Never reuse development values. See docs/SECURITY_AUDIT.md for what the proxy must do.

# Production connects as a runtime role that owns nothing: see scripts/db_hardening.py.
# Production runs in containers (deploy/README.md), where secrets are files, never variables:
# FINPILOT_SECRETS_DIR=/run/secrets holds database_url and google_client_secret.
# Migrations there use MIGRATION_DATABASE_URL (the schema owner), never DATABASE_URL.
# TRUSTED_PROXIES names the reverse proxy, whose X-Forwarded-For alone is believed. Required in
# production. Leave it unset in development.
# TRUSTED_PROXIES=172.30.10.2

# Optional connection limits. These are the defaults.
# DB_POOL_SIZE=5
# DB_MAX_OVERFLOW=5
# DB_POOL_TIMEOUT_SECONDS=5
# DB_CONNECT_TIMEOUT_SECONDS=3
# DB_STATEMENT_TIMEOUT_MS=15000
